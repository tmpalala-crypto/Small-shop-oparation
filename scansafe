<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>ScanSafeAfrica V9.4 GHOST</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#FFD700">
<style>
*{margin:0;padding:0;box-sizing:border-box}body{background:#000;color:#fff;font-family:Arial;padding:10px}
.lock{position:fixed;top:0;left:0;width:100%;height:100%;background:#000;z-index:9999;display:flex;justify-content:center;align-items:center;flex-direction:column;padding:20px}
.lock-box{background:#111;border:2px solid #b8860b;border-radius:15px;padding:20px;width:100%;max-width:300px;text-align:center}
.header{background:#fff;border-radius:15px;padding:12px;text-align:center;margin-bottom:10px;border:3px solid #0a3d8f}
.header img{width:95px;height:95px;border-radius:50%;object-fit:contain;border:2px solid #b8860b}
.header h1{color:#0a3d8f;font-size:20px;margin-top:5px;font-weight:900}
.auto{background:#111;border:1px solid #00ff88;border-radius:8px;padding:7px;margin:5px 0;font-size:11px;color:#00ff88;display:flex;justify-content:space-between}
.card{background:#111;border:2px solid #0a3d8f;border-radius:12px;padding:12px;margin-bottom:10px}
.card h2{color:#ff9900;font-size:13px;margin-bottom:8px;text-align:center}
input,select{width:100%;padding:10px;border-radius:8px;border:1px solid #333;background:#222;color:#fff;font-size:12px;margin-top:5px}
.btn{width:100%;padding:12px;border:none;border-radius:10px;font-weight:bold;margin-top:7px;cursor:pointer;font-size:12px}
.btn-red{background:linear-gradient(90deg,#ff0000,#ff6600);color:#fff}
.btn-gold{background:linear-gradient(90deg,#0a3d8f,#b8860b);color:#fff}
.install{width:100%;padding:12px;background:gold;color:#000;border:none;border-radius:10px;font-weight:900;margin-bottom:10px;display:none}
.qiniso{background:linear-gradient(90deg,#0a3d8f,#b8860b);color:#fff;padding:9px;border-radius:10px;text-align:center;font-size:11px;margin:6px 0;font-weight:bold}
.disc{background:#1a1a1a;border:1px solid #555;border-radius:8px;padding:10px;margin-top:10px}
.disc p{color:#ffcc00;font-size:8px;text-align:center;line-height:1.4}
</style></head><body>
<div id="ghostLock" class="lock">
<div class="lock-box">
<h2 style="color:#b8860b">🔒 QINISO VAULT LOCKED</h2>
<p style="font-size:10px;color:#888;margin:10px 0">CEO ONLY - Enter Secret Code</p>
<input type="password" id="vaultCode" placeholder="Enter Secret Code">
<button class="btn btn-gold" onclick="unlock()">🔓 UNLOCK VAULT</button>
</div>
</div>
<div class="header">
<img src="https://i.ibb.co/Tx5mPQMK/IMG-20260831-WA9561.jpg" alt="logo">
<h1>ScanSafeAfrica</h1>
<p>SECURE • VERIFIED • ANTI-COUNTERFEIT • OFFICIAL</p>
<p style="color:#ff0000;font-size:10px;margin-top:4px">QINISO MARK™ COMPLIANCE TRACE SYSTEM</p>
</div>
<div class="auto"><span>📍 <span id="agps">Locating...</span></span><span>⏰ <span id="atime">--:--</span></span></div>
<div class="qiniso">🛡️ V9.4 GHOST LOCKED → ONLY CEO ACCESS</div>
<button id="installBtn" class="install">📲 INSTALL APP TO PHONE</button>
<div class="card"><h2>🏪 SHOP COMPLIANCE & TRACE</h2>
<input id="shop" placeholder="Shop Name">
<input id="cipc" placeholder="CIPC Reg No">
<input id="taxRef" placeholder="Tax Ref No">
<input id="barcode" placeholder="Product Barcode">
<input id="ssa" placeholder="SSA Secret Code">
<select id="result">
<option>SELECT TRACE RESULT</option>
<option value="QINISO_PASS">✅ QINISO PASS</option>
<option value="SUSPECTED">⚠️ SUSPECTED FAKE</option>
<option value="FAKE">❌ CONFIRMED FAKE</option>
</select>
<button class="btn btn-red" onclick="submitR()" style="padding:16px;font-size:14px">🚨 SUBMIT + TRACE + ALERT</button>
</div>
<div class="card"><h2>📊 LIVE TRACE FEED</h2><div id="reports"></div></div>
<div class="card"><button class="btn" style="background:#222;color:#888" onclick="logout()">🔒 LOCK VAULT (Logout)</button></div>
<div class="disc"><p>⚠️ DISCLAIMER: ScanSafeAfrica & Qiniso Mark™ is an INDEPENDENT, UNOFFICIAL pilot system developed in Bethelsdorp. NOT affiliated with SARS, NCC, SAPS. Community safety tool.</p></div>
<script>
const SECRET="Judy060664";
function unlock(){let c=document.getElementById('vaultCode').value;if(c===SECRET){document.getElementById('ghostLock').style.display='none';localStorage.setItem('qinisoAuth','true');alert('✅ VAULT UNLOCKED - Welcome CEO!');}else{alert('❌ WRONG CODE!');}}
function logout(){localStorage.removeItem('qinisoAuth');location.reload();}
if(localStorage.getItem('qinisoAuth')==='true'){document.getElementById('ghostLock').style.display='none';}
let reports=JSON.parse(localStorage.getItem('ssafrica94')||'[]');let auto={gps:'Bethelsdorp'};
function init(){if(navigator.geolocation){navigator.geolocation.getCurrentPosition(p=>{auto.gps=p.coords.latitude.toFixed(5)+','+p.coords.longitude.toFixed(5);document.getElementById('agps').innerText=auto.gps;});}setInterval(()=>{document.getElementById('atime').innerText=new Date().toLocaleString('en-ZA');},1000);render();}
function submitR(){let d={shop:shop.value,cipc:cipc.value,tax:taxRef.value,barcode:barcode.value,ssa:ssa.value,result:result.value,gps:auto.gps,time:new Date().toLocaleString('en-ZA')};if(!d.shop||!d.result){alert('Fill shop + result!');return;}reports.unshift(d);localStorage.setItem('ssafrica94',JSON.stringify(reports));let msg=`🛡️ SCANSAFE AFRICA V9.4 GHOST\n🏪 Shop: ${d.shop}\nResult: ${d.result}\n📍 ${d.gps}\n⏰ ${d.time}`;window.open('https://wa.me/?text='+encodeURIComponent(msg));render();alert('✅ TRACED!');}
function render(){let h='';reports.slice(0,10).forEach(r=>{let col=r.result.includes('PASS')?'#00ff88':'#ff3300';h+=`<div style="background:#222;padding:7px;border-radius:7px;margin-top:5px;border-left:4px solid ${col}"><b>${r.shop}</b> - ${r.result}<br><small style="color:#888">${r.gps} | ${r.time}</small></div>`});document.getElementById('reports').innerHTML=h||'<small style="color:#666">No traces yet</small>';}
let deferredPrompt; const btn=document.getElementById('installBtn');
window.addEventListener('beforeinstallprompt',(e)=>{e.preventDefault();deferredPrompt=e;btn.style.display='block';});
btn.addEventListener('click',async()=>{if(deferredPrompt){deferredPrompt.prompt();await deferredPrompt.userChoice;deferredPrompt=null;btn.style.display='none';}});
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js');}
init();
</script></body></html>
